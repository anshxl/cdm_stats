# Environment variables the API reads. All are optional. Set them in your shell
# (export NAME=value) or in your host's dashboard; the app does not load a .env file.

# Basic-auth login for the dashboard. Without a password, every page and API
# route is public, so always set one in production.
# DASHBOARD_USER=cdm
# DASHBOARD_PASSWORD=

# Enables the H2H pre-match brief (calls Claude, which costs API credits).
# ANTHROPIC_API_KEY=

# Training page: the Discord bot's GET /training endpoint and its bearer token.
# If unset, the page shows a "not configured" card.
# TRAINING_API_URL=
# TRAINING_API_TOKEN=

# SQLite database path. Default: data/cdl.db
# DB_PATH=

# Port for the production server (set by the host; the Dockerfile uses it).
# PORT=8000
